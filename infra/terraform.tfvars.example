# Copy to terraform.tfvars (local runs) – CI passes the same values as TF_VAR_* variables.
region            = "ap-southeast-1"
alarm_email       = "you@example.com"
ses_sender_email  = "you@example.com"
ses_verify_emails = ["tutor.test@example.com", "student.test@example.com"]

# Normal month (default). Set exam_mode = true a week before exams and push to main.
exam_mode                   = false
db_instance_class           = "db.t4g.medium" # demo: "db.t4g.micro"
db_instance_class_exam      = "db.t4g.large"
api_provisioned_concurrency = 100             # new accounts (10 concurrency quota): request an increase first
deletion_protection         = false           # true in production
campus_cidrs                = []              # e.g. ["203.0.113.0/24"] – university NAT addresses

# Optional custom domain (needs a Route 53 hosted zone)
# domain_name      = "exams.example.edu"
# hosted_zone_name = "example.edu"
